# Este diretório NÃO deve ser servido pelo Apache diretamente: ele contém .env, vendor/, storage/ etc.
# O Apache só deve apontar (DocumentRoot / VirtualHost) para a pasta "public/".
# Enquanto não houver VirtualHost, o desenvolvimento usa "php artisan serve" (http://localhost:8000).
Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
